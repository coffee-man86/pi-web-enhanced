+/**
+ * Delete a file or directory (recursively). Only allowed inside file roots.
+ */
+export async function DELETE(
+  request: NextRequest,
+  { params }: { params: Promise<{ path: string[] }> }
+) {
+  if (!isApiRequestAllowed(request)) {
+    return NextResponse.json({ error: "Untrusted API request" }, { status: 403 });
+  }
+  try {
+    const { path: segments } = await params;
+    const target = filePathFromSegments(segments);
+    const allowedRoots = await getAllowedFileRoots();
+    if (!isExistingFilePathAllowed(target, allowedRoots)) {
+      return NextResponse.json({ error: "Access denied" }, { status: 403 });
+    }
+    let stat: fs.Stats;
+    try {
+      stat = fs.statSync(target);
+    } catch {
+      return NextResponse.json({ error: "Not found" }, { status: 404 });
+    }
+    if (!stat.isDirectory() && !stat.isFile()) {
+      return NextResponse.json({ error: "Cannot delete this entry" }, { status: 400 });
+    }
+    fs.rmSync(target, { recursive: true, force: false });
+    return NextResponse.json({ deleted: target });
+  } catch (error) {
+    console.error("[files-op][DELETE]", error);
+    return NextResponse.json({ error: error instanceof Error ? error.message : String(error) }, { status: 500 });
+  }
+}
+
+/**
+ * Rename or move a file/directory. Body: { action: "rename"|"move", target: string }
+ * target is either an absolute path inside the allowed roots, or a new name in
+ * the same directory (for "rename").
+ */
+export async function PATCH(
+  request: NextRequest,
+  { params }: { params: Promise<{ path: string[] }> }
+) {
+  if (!isApiRequestAllowed(request)) {
+    return NextResponse.json({ error: "Untrusted API request" }, { status: 403 });
+  }
+  try {
+    const { path: segments } = await params;
+    const source = filePathFromSegments(segments);
+    const allowedRoots = await getAllowedFileRoots();
+    if (!isExistingFilePathAllowed(source, allowedRoots)) {
+      return NextResponse.json({ error: "Access denied" }, { status: 403 });
+    }
+    const body = await request.json().catch(() => null) as { action?: unknown; target?: unknown } | null;
+    const action = body?.action;
+    const targetRaw = body?.target;
+    if ((action !== "rename" && action !== "move") || typeof targetRaw !== "string") {
+      return NextResponse.json({ error: "action (rename|move) and target are required" }, { status: 400 });
+    }
+    // rename: target 是新文件名（同目录）；move: target 是目标目录，最终路径 = 目录 + 原文件名
+    const target = action === "move"
+      ? path.join(
+          targetRaw.startsWith("/") ? normalizeSlashes(targetRaw) : targetRaw.trim(),
+          path.basename(source),
+        )
+      : path.join(path.dirname(source), targetRaw.trim());
+    if (!isFilePathAllowed(target, allowedRoots)) {
+      return NextResponse.json({ error: "Access denied" }, { status: 403 });
+    }
+    // 不能把目录移动/改名为它自己的子目录（fs 会报 EINVAL，这里提前返回友好错误）
+    if (action === "move" && fs.existsSync(source) && fs.statSync(source).isDirectory()) {
+      const normalizedTarget = normalizeSlashes(target).replace(/\/$/, "");
+      if (normalizedTarget === source || normalizedTarget.startsWith(source + "/")) {
+        return NextResponse.json({ error: "Cannot move a folder into its own subdirectory" }, { status: 400 });
+      }
+    }
+    // 目标父目录的 realpath 校验：防止目标路径中的符号链接把写入重定向到允许根之外
+    // （与上传的防护一致：symlink inside an allowed root cannot redirect outside it）
+    const targetParent = path.dirname(target);
+    let realParent: string;
+    try {
+      realParent = fs.realpathSync(targetParent);
+    } catch {
+      return NextResponse.json({ error: "Target directory does not exist" }, { status: 404 });
+    }
+    const realRoots = new Set<string>();
+    for (const root of allowedRoots) {
+      try { realRoots.add(fs.realpathSync(root)); } catch { /* 忽略失效根 */ }
+    }
+    if (!isFilePathAllowed(realParent, realRoots)) {
+      return NextResponse.json({ error: "Access denied" }, { status: 403 });
+    }
+    if (!fs.existsSync(source)) {
+      return NextResponse.json({ error: "Source not found" }, { status: 404 });
+    }
+    if (fs.existsSync(target)) {
+      return NextResponse.json({ error: "Target already exists" }, { status: 409 });
+    }
+    fs.renameSync(source, target);
+    return NextResponse.json({ moved: { from: source, to: target } });
+  } catch (error) {
+    console.error("[files-op][PATCH]", error);
+    return NextResponse.json({ error: error instanceof Error ? error.message : String(error) }, { status: 500 });
+  }
+}
